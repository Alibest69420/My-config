                "color": "#404040"
              },
              "constant": {
                "color": "#80e680"
              },
              "function": {
                "color": "#80e6e6"
              },
              "keyword": {
                "color": "#6699ff"
              },
              "number": {
                "color": "#cc66cc"
              },
              "operator": {
                "color": "#6699ff"
              },
              "string": {
                "color": "#e65c5c"
              },
              "variable": {
                "color": "#66cc66"
              }
            },
            "players": [
              {
                "cursor": "#e6e6e6",
                "background": "#262626",
                "selection": "#e6e6e630"
