            "scrollbar.thumb.background": "#e6e6e6",
            "editor.gutter.background": "#26262690",
            "terminal.background": "#26262610",
            "terminal.foreground": "#e6e6e6",
            "terminal.dim_foreground": "#e6e6e6",
            "terminal.bright_foreground": "#e6e6e6",
            "terminal.ansi.black": "#262626",
            "terminal.ansi.red": "#e65c5c",
            "terminal.ansi.green": "#66cc66",
            "terminal.ansi.yellow": "#ffcc66",
            "terminal.ansi.blue": "#6699ff",
            "terminal.ansi.magenta": "#cc66cc",
            "terminal.ansi.cyan": "#66cccc",
            "terminal.ansi.white": "#f2f2f2",
            "terminal.ansi.bright_black": "#404040",
            "terminal.ansi.bright_red": "#ff6666",
            "terminal.ansi.bright_green": "#80e680",
            "terminal.ansi.bright_yellow": "#ffdd80",
            "terminal.ansi.bright_blue": "#80b3ff",
            "terminal.ansi.bright_magenta": "#e680e6",
            "terminal.ansi.bright_cyan": "#80e6e6",
            "terminal.ansi.bright_white": "#ffffff",
            "modified": "#e65c5c",
