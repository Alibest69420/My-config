    {
      "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
      "name": "Omarchyy",
      "author": "@bypass_",
      "themes": [
        {
          "name": "Omarchy",
          "appearance": "dark",
          "style": {
            "background": "#00000090",
            "editor.background": "#00000090",
            "editor.foreground": "#e6e6e6",
            "text": "#e6e6e6",
