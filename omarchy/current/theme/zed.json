            "element.hover": "#e6e6e630",
            "ghost_element.hover": "#40404030",
            "ghost_element.selected": "#40404030",
            "ghost_element.active": "#40404060",
            "border": "#262626",
            "editor.highlighted_line.background": "#40404010",
            "editor.active_line.background": "#40404010",
            "panel.background": "#26262690",
            "title_bar.background": "#26262690",
            "title_bar.inactive_background": "#26262690",
            "status_bar.background": "#26262690",
            "drop_target.background": "#26262690",
            "elevated_surface.background": "#262626",
            "toolbar.background": "#26262690",
            "tab_bar.background": "#26262690",
            "tab.inactive_background": "#26262690",
