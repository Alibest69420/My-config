{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/pngs/\" -name \"*.png\" | shuf -n 1)",
    "height": 14,
  },
  "modules": [
    {
      "type": "command",
      "key": "  \ue900 System",
      "keyColor": "red",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\"",
    },
    {
      "type": "command",
      "key": "  󰘬 Branch",
      "keyColor": "red",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\"",
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "red",
    },
    {
      "type": "wm",
      "key": "   Compositor",
      "keyColor": "yellow",
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow",
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age ",
      "keyColor": "31",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime ",
      "keyColor": "red",
    },
    "break",
    {
      "type": "title",
      "key": "       ",
    },
    {
      "type": "custom",
      "format": "     ┌──────────────────────────────────────────┐",
    },
    {
      "type": "display",
      "format": "SADES SA-HC02Q27 27-inch 2K @ {refresh-rate}Hz",
      "key": "  󱩛 Display",
      "keyColor": "magenta",
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "showPeCoreCount": true,
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "format": "NVIDIA Geforce RTX 3060 12GB",
      "key": "  󰘚 GPU",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "  󰸌 Theme",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m       : System Misc",
    },
    {
      "type": "custom",
      "format": "     ┌─────────────────────────────────────────────────┐",
    },
    {
      "type": "board",
      "key": "   Motherboard",
      "keyColor": "green",
    },
    {
      "type": "bios",
      "key": "  󱤓 AM5 UEFI",
      "format": "AGESA {version} - {date}",
      "keyColor": "green",
    },
    {
      "type": "physicaldisk",
      "key": "   SSD",
      "keyColor": "magenta",
      "format": "{name} - {size}",
    },
    {
      "type": "memory",
      "key": "   RAM",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "     └~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~┘",
    },
    "break",
  ],
}
